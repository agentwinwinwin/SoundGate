DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
MYSQL_DATABASE=soundgate
MYSQL_USER=soundgate
MYSQL_PASSWORD=soundgate_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DEVICE_ADMIN_PASSWORD=change-this-local-admin-password
MAX_SCHEDULE_SLOTS_PER_DAY=12
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ONENET_PRODUCT_ID=your-product-id
ONENET_USER_ID=
ONENET_ACCESS_KEY=
ONENET_ACCESS_KEY_IS_BASE64=false
ONENET_API_KEY=
ONENET_AUTH_MODE=auto
ONENET_DEVICE_TOKEN=
ONENET_TOKEN_VERSION=2018-10-31
ONENET_TOKEN_METHOD=md5
ONENET_API_URL=https://iot-api.heclouds.com/thingmodel/set-device-property
ONENET_LEGACY_API_BASE=https://api.heclouds.com
ONENET_GATEWAY_DEVICE_NAME=your-gateway-device
ONENET_GATEWAY_DEVICE_ID=
ONENET_MQTT_HOST=183.230.102.116
ONENET_MQTT_PORT=25002
# 必须与OneNET产品中实际创建并授权的自定义Topic一致
ONENET_CUSTOM_TOPIC_DOWN=soundgate/{pid}/{device}/cmd/down
ONENET_CUSTOM_TOPIC_UP=soundgate/{pid}/+/cmd/up
ONENET_COMMAND_TIMEOUT_SECONDS=5
ONENET_COMMAND_MAX_RETRIES=3
# wav：街道名称由平台生成/上传WAV；tts：终端支持street_set/street_get
STREET_AUDIO_MODE=wav
